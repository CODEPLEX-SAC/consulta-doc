# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8076

# ── Base de datos (CockroachDB) ───────────────────────────────────────────────
DB_HOST=144.217.163.120
DB_PORT=26257
DB_NAME=consulta_sunat
DB_USER=dev_user
DB_PASSWORD=CAMBIAR_POR_CONTRASEÑA_REAL
DB_SSL=true
DB_SSL_MODE=require
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Padrones SUNAT ────────────────────────────────────────────────────────────
PADRON_RUC_URL=http://www2.sunat.gob.pe/padron_reducido_ruc.zip
PADRON_LOCAL_ANEXO_URL=https://www.sunat.gob.pe/descargaPRR/padron_reducido_local_anexo.zip
PADRON_DOWNLOAD_TIMEOUT_MS=1800000
PADRON_TMP_DIR=/tmp
PADRON_BATCH_SIZE=2000

# ── Scraper público SUNAT ─────────────────────────────────────────────────────
SUNAT_CAPTCHA_MAX_RETRIES=3
SUNAT_REQUEST_TIMEOUT_MS=15000
SUNAT_MIN_DELAY_MS=2000

# ── Caché ─────────────────────────────────────────────────────────────────────
CACHE_TTL_HOURS=24

# ── Autenticación para endpoints /admin ───────────────────────────────────────
ADMIN_API_KEY=DEFINIR_CLAVE_SECRETA_ALEATORIA

